# In Vercel unter Settings → Environment Variables eintragen. NICHT in Git einchecken.

# Passwort für die Web-Oberfläche (mind. 10 Zeichen, besser 20+)
APP_PASSWORD=

# Geheimer Schlüssel zum Verschlüsseln der Cookies (mind. 32 Zeichen, zufällig).
# Erzeugen z. B. mit:  openssl rand -base64 48
SESSION_SECRET=

# Optional: Land/Sprache der Bestellung (Standard DE / de)
TESLA_COUNTRY=DE
TESLA_LANGUAGE=de

# Optional: Referenznummer(n) der Bestellung, kommagetrennt (nur nötig, wenn das
# Tesla-Konto die Bestellung nicht automatisch liefert)
TESLA_ORDER_RN=

# Optional: Gültigkeit der Web-Anmeldung in Tagen (Standard 30)
APP_SESSION_DAYS=30
